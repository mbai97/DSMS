Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Protect sensitive directories.
RewriteRule ^(config|database|includes|vendor)/ - [F,L,NC]
RewriteRule ^storage/(logs|certificates|qrcodes)/ - [F,L,NC]

# Allow direct access to admin directory
RewriteRule ^admin/.*\.php$ - [L]

# Allow direct access to public directory
RewriteRule ^public/.*\.php$ - [L]

# Public certificate verification route.
RewriteRule ^c/([A-Za-z0-9]{64})/?$ public/c.php?token=$1 [L,QSA]

# Public home page.
RewriteRule ^$ public/home.php [L]
